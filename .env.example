AUTH_SECRET=replace-with-a-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
DATABASE_URL=mongodb://localhost:27017/vibecode?replicaSet=rs0
AUTH_URL=http://localhost:3000

# Server-side only. Production requires an explicitly reachable private endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_MS=180000

# Optional comma-separated installed model names permitted for AI requests.
# OLLAMA_ALLOWED_MODELS=gpt-oss:20b
